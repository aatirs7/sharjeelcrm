# --- Neon Postgres ---
# From the Neon dashboard (https://console.neon.tech) > your project > Connection Details.
# Use the POOLED connection string (host contains "-pooler"). Include ?sslmode=require.
DATABASE_URL=

# --- Auth (shared PIN gate) ---
# Every page except /login and /api/* requires this 5-digit PIN. The app runs
# as a single local admin rep once unlocked. Defaults to 11005 if unset.
APP_PIN=11005
# Secret used to HMAC the PIN into the session cookie (so the cookie never
# contains the PIN). Change it to force everyone to re-enter the PIN.
# Generate one with:  openssl rand -hex 32
APP_PIN_SECRET=

# --- Cron protection ---
# Any long random string. Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=

# --- Phase 2 Discord bot (not built yet) ---
# Shared bearer secret the future Discord bot uses to POST /api/discord/lead.
# Generate one with:  openssl rand -hex 32
DISCORD_WEBHOOK_SECRET=
