# --- Neon Postgres ---
# From the Neon dashboard (https://console.neon.tech) > your project > Connection Details.
# Use the POOLED connection string (host contains "-pooler"). Include ?sslmode=require.
DATABASE_URL=

# --- Clerk auth ---
# From https://dashboard.clerk.com > your app > API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where Clerk mounts its sign-in / sign-up UI (leave as-is unless you move the routes).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Cron protection ---
# Any long random string. Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=

# --- Phase 2 Discord bot (not built yet) ---
# Shared bearer secret the future Discord bot uses to POST /api/discord/lead.
# Generate one with:  openssl rand -hex 32
DISCORD_WEBHOOK_SECRET=
